# Dhan Broker Configuration Template
# Copy this file to .env.development or .env.production and fill in your credentials

# ==========================================
# API Configuration
# ==========================================
PORT=3089
NODE_ENV=development
FRONTEND_URL=http://localhost:5178

# ==========================================
# Dhan Broker Credentials
# ==========================================
# Get these from your Dhan account
# Visit: https://web.dhan.co → Profile → DhanHQ Trading APIs

# Your Dhan Client ID
# Example: DC123456
DHAN_CLIENT_ID=your_dhan_client_id_here

# Your Dhan Access Token
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# ==========================================
# Optional: Multiple Dhan Accounts (for copy trading)
# ==========================================

# Master Account
DHAN_MASTER_CLIENT_ID=master_client_id_here
DHAN_MASTER_ACCESS_TOKEN=master_access_token_here

# Child Account 1
DHAN_CHILD1_CLIENT_ID=child1_client_id_here
DHAN_CHILD1_ACCESS_TOKEN=child1_access_token_here
DHAN_CHILD1_MULTIPLIER=1.0

# Child Account 2
DHAN_CHILD2_CLIENT_ID=child2_client_id_here
DHAN_CHILD2_ACCESS_TOKEN=child2_access_token_here
DHAN_CHILD2_MULTIPLIER=0.5

# ==========================================
# Trading Configuration
# ==========================================

# Default product type for orders
# Options: CNC (Cash and Carry), INTRA (Intraday), MARGIN, CO, BO
DHAN_DEFAULT_PRODUCT=INTRA

# Default order validity
# Options: DAY, IOC (Immediate or Cancel)
DHAN_DEFAULT_VALIDITY=DAY

# Enable trade logging
DHAN_ENABLE_LOGGING=true

# Log file location
DHAN_LOG_FILE=./logs/dhan_trading.log

# ==========================================
# Risk Management
# ==========================================

# Maximum order quantity (safeguard against large accidental orders)
DHAN_MAX_ORDER_QUANTITY=100

# Minimum margin required to place order (in rupees)
DHAN_MIN_MARGIN_BUFFER=5000

# Enable order validation
DHAN_ENABLE_ORDER_VALIDATION=true

# ==========================================
# API Limits
# ==========================================

# Maximum number of API calls per minute
DHAN_API_RATE_LIMIT=60

# API request timeout (in milliseconds)
DHAN_API_TIMEOUT=30000

# Retry failed API calls
DHAN_ENABLE_RETRY=true
DHAN_MAX_RETRIES=3

# ==========================================
# Development Settings (only for development)
# ==========================================

# Enable mock trading (simulated orders without real execution)
DHAN_MOCK_TRADING=false

# Enable debug logging
DHAN_DEBUG=false

# ==========================================
# Notes
# ==========================================
# 1. Keep this file secure - do not commit to version control
# 2. Never share your access tokens
# 3. Use different tokens for development and production
# 4. Regularly rotate your access tokens for security
# 5. Test with small quantities before scaling up
